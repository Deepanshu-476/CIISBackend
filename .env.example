# Existing backend settings
PORT=3000
NODE_ENV=production
MONGO_URI=
JWT_SECRET=

# Email SMTP
# Gmail requires a 16-character App Password, not your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password

# Free Metered Open Relay TURN
# If dashboard URL is https://your-app.metered.live, use your-app here.
METERED_TURN_APP_NAME=
METERED_TURN_API_KEY=
