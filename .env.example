# Existing backend settings
PORT=3000
NODE_ENV=production
MONGO_URI=
JWT_SECRET=

# Email SMTP
# Gmail requires a 16-character App Password, not your normal Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password

# Free Metered Open Relay TURN
# If dashboard URL is https://your-app.metered.live, use your-app here.
METERED_TURN_APP_NAME=
METERED_TURN_API_KEY=

# AI Task Agent (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Groq Whisper STT (default whisper-large-v3-turbo; whisper-large-v3 is more accurate for complex Hinglish)
GROQ_STT_MODEL=whisper-large-v3-turbo
# STT Language: hi | en | auto (default follows client mic setting; 'auto' omits language param)
GROQ_STT_LANGUAGE=auto
AI_STT_DAILY_LIMIT=120

# Self-hosted Coturn TURN for WebRTC calling
# Keep the permanent shared secret on the backend only. Never expose it through
# React/Vite frontend environment variables.
COTURN_HOST=turn.ciisnetwork.in
COTURN_URLS=stun:turn.ciisnetwork.in:3478,turn:turn.ciisnetwork.in:3478?transport=udp,turn:turn.ciisnetwork.in:3478?transport=tcp
COTURN_STATIC_AUTH_SECRET=
COTURN_CREDENTIAL_TTL_SECONDS=3600
